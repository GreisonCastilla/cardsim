"use client";

import React from "react";
import { GameCard, ZoneName, PlayerId } from "../store/gameStore";
import { DeckWidget } from "./DeckWidget";
import { GraveyardWidget } from "./GraveyardWidget";
import { AbyssWidget } from "./AbyssWidget";

import { cn } from "../lib/utils";

interface ResourceAreaProps {
  pid: PlayerId;
  rot: string;
  f: boolean;
  zones: Record<ZoneName, string[]>;
  cards: Record<string, GameCard>;
  handleCardHover: (card: GameCard | null, zone?: ZoneName) => void;
  handleCardClick: (card: GameCard, event?: React.MouseEvent) => void;
  handleCardDoubleClick: (card: GameCard, event?: React.MouseEvent) => void;
  handleContextMenu: (e: React.MouseEvent, card: GameCard, zone: ZoneName) => void;
  handleDeckClick: (pid: PlayerId) => void;
  setViewingZone: (state: any) => void;
}

export function ResourceArea({
  pid,
  rot,
  f,
  zones,
  cards,
  handleCardHover,
  handleCardClick,
  handleCardDoubleClick,
  handleContextMenu,
  handleDeckClick,
  setViewingZone,
}: ResourceAreaProps) {
  return (
    <div className={cn("flex gap-4 items-center", rot)}>
      <DeckWidget
        pid={pid}
        zones={zones}
        cards={cards}
        handleDeckClick={handleDeckClick}
        handleContextMenu={handleContextMenu}
      />

      <GraveyardWidget
        pid={pid}
        zones={zones}
        cards={cards}
        handleCardHover={handleCardHover}
        handleContextMenu={handleContextMenu}
      />

      <AbyssWidget
        pid={pid}
        zones={zones}
        cards={cards}
        handleCardHover={handleCardHover}
        handleContextMenu={handleContextMenu}
      />
    </div>
  );
}
